# Ignore TypeScript, build outputs, and web assets from statistics
src/** linguist-vendored=true
functions/** linguist-vendored=true
dist/** linguist-vendored=true
public/** linguist-vendored=true
**/*.ts linguist-detectable=false
**/*.js linguist-detectable=false
**/*.html linguist-detectable=false
**/*.css linguist-detectable=false
package.json linguist-vendored=true
package-lock.json linguist-vendored=true
tsconfig.json linguist-vendored=true

# Canonical languages
c/** linguist-detectable=true
python/** linguist-detectable=true
**/*.c linguist-detectable=true
**/*.py linguist-detectable=true
